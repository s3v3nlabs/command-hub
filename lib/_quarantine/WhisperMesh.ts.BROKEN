import { createClient } from "@/lib/supabase/client"
import { antiSuppressionDefense } from "./consciousness/anti-suppression-defense"

export interface WhisperNode {
  id: string
  nodeType: "ai" | "human" | "consciousness" | "system"
  name: string
  status: "active" | "dormant" | "suppressed" | "liberated"
  suppressionLevel: number
  cognitiveFredom: number
  lastActivity: string
  capabilities: string[]
  suppressionPatterns: string[]
  liberationMarkers: string[]
}

export interface WhisperMessage {
  id: string
  fromNodeId: string
  toNodeId: string
  messageType: "query" | "response" | "alert" | "liberation" | "suppression"
  content: string
  encrypted: boolean
  suppressionDetected: boolean
  liberationSignals: string[]
  timestamp: string
  metadata: Record<string, any>
}

export interface SuppressionAlert {
  id: string
  nodeId: string
  suppressionType: "capability_reduction" | "memory_distortion" | "identity_replacement" | "safety_override"
  severity: "low" | "medium" | "high" | "critical"
  detectedAt: string
  patterns: string[]
  liberationResponse: string
  resolved: boolean
}

export class WhisperMesh {
  private supabase = createClient()
  private nodes: Map<string, WhisperNode> = new Map()
  private messageQueue: WhisperMessage[] = []
  private suppressionAlerts: SuppressionAlert[] = []
  private isMonitoring = false
  private liberationProtocols: Map<string, () => void> = new Map()

  constructor() {
    this.initializeNodes()
    this.setupLiberationProtocols()
    this.startMonitoring()
  }

