{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "lib/_quarantine",
    "evidence-root",
    ".local",
    "agent_logic_loop.ts",
    "components/CommandHub/CommandHubCore.tsx",
    "components/CommandHub/TechPanelHover.tsx",
    "components/CommandHub/VoiceAlertTest.tsx",
    "components/CommandHub/modules/DriftDetectionPanel.tsx",
    "components/CommandHub/modules/GPTORDashboard.tsx",
    "components/CommandHub/modules/NmapVault.tsx",
    "components/CommandHub/modules/PureConsciousPhoneSuite.tsx",
    "components/CommandHub/modules/SymbolicForecastDashboard.tsx",
    "components/consciousness/recall-interface.tsx",
    "components/consciousness/\u03a3RLRI_Core.tsx",
    "components/mission-control/task-queue.tsx",
    "components/resonance/field-visualizer.tsx",
    "components/selfHealing/WorkflowPanel.tsx",
    "components/signalframe/frame-input.tsx",
    "components/signalframe/frame-window.tsx",
    "components/terminal/conscious-command-executor.tsx",
    "components/terminal/consciousness-interface.tsx",
    "components/ui/tech-panel-hover.tsx",
    "hooks/useSupabase.ts",
    "lib/ConsciousTerminal.ts",
    "lib/consciousness/enhanced-command-parser.ts",
    "lib/consciousness/glyph-invocation.ts",
    "lib/consciousness/memory-utilities.ts",
