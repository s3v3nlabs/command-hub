COMPUTE_OPENAI_MODEL=""
COMPUTE_OPENAI_API_KEY=""
COMPUTE_OPENAI_API_KEY_ENV=""
RUNPOD_ENDPOINT_URL=""
RUNPOD_BASE_URL=""
RUNPOD_MODEL=""
RUNPOD_CHAT_PATH=""
RUNPOD_API_KEY=""

# Staged-ladder Stage-1 master flags (off by default; enable per-feature on authorized hosts)
RECON_ACTIVE_ENABLED="0"
DECEPTION_VT_SUBMIT_ENABLED="0"

# Heimdall eyes-only encrypted logs (AES-256-GCM). 32-byte hex/base64 or passphrase. Never commit a value.
HEIMDALL_LOG_KEY=""
# Token that may DECRYPT eyes-only logs (defaults to HEIMDALL_LOG_KEY if unset).
HEIMDALL_SUBSYSTEM_TOKEN=""
# VirusTotal (opt-in sample analysis). Server-side only.
VT_API_KEY=""
# Planned privilege-separation daemon socket (unset = in-process fallback).
AGENT_SOCKET_PATH=""

# Android Lab (local emulator + adb). Optional; well-known SDK paths are also probed.
# Used only for operator-owned / authorized local AVDs and apps.
ANDROID_SDK_ROOT=""
ANDROID_HOME=""
ANDROID_AVD_HOME=""
# Optional override for APK/push/pull workspace (default: data/offsec/android-lab).
ANDROID_LAB_WORKSPACE=""

# Reverse Engineering Workbench (/offsec/reverse-engineering). All optional.
# REA (github.com/morluto/rea, MIT) speaks MCP over stdio: e.g. REA_MCP_COMMAND="rea mcp"
# or REA_MCP_COMMAND="npx -y rea-agents@6.8.0 mcp". REA_MCP_URL = optional Streamable-HTTP bridge.
REA_MCP_COMMAND=""
REA_MCP_URL=""
# Direct engines (auto-detected on PATH when unset).
RADARE2_BIN=""
GHIDRA_INSTALL_DIR=""
# radare2 analysis depth: aa (default) | aaa | aaaa
RE_R2_ANALYSIS=""
RE_ENGINE_TIMEOUT_MS=""
RE_GHIDRA_TIMEOUT_MS=""
RE_MAX_UPLOAD_MB=""
# Stage-1 switch for DYNAMIC REA tools (Frida/gdb/ADB/capture). Leave empty on daily drivers.
RE_DYNAMIC_ENABLED=""

# Black Aurora Labs invite portal (/black-aurora).
# Mode: "bundle" (default) = gated git-bundle/tarball download after verify.
#       "github-private" = documented path only (make repo private; no live token minting).
BLACK_AURORA_MODE=""

# Ghostlight Vault (/vault) — local ChatGPT-export search service (Python MCP + REST).
# The hub proxies to this URL. The token is used server-side only and is never
# sent to the browser. Leave empty until you start modules/ghostlight-vault/run.sh.
# See docs/GHOSTLIGHT_VAULT.md.
GHOSTLIGHT_VAULT_URL=""
GHOSTLIGHT_VAULT_TOKEN=""
# Alias accepted by both the hub proxy and the Python server:
# GHOSTLIGHT_MCP_TOKEN=""

