# Security hardening (see SECURITY.md)
# Required on any shared/reachable host. Gates Device Bridge session join + live media
# (and most other mutating APIs). Pass as Authorization: Bearer <token>.
HUB_API_TOKEN=""
OPERATOR_API_TOKEN=""
ADB_SHELL_ENABLED="0"
HEIMDALL_MEMORY_KEY=""

# CCTV video wall — staged unlock for third-party connect / ffmpeg transcode
CCTV_CONNECT_ENABLED="0"

# Dev Operator local model backend (OpenAI-compatible / Ollama). Optional.
LOCAL_LLM_BASE_URL=""
OLLAMA_BASE_URL=""
LOCAL_LLM_MODEL=""

# Compute / AI Acceleration pool (multi-backend router + job queue). Optional.
# JSON array of {id,kind,baseUrl,label,maxConcurrency,costWeight,defaultModel,apiKeyEnv}
# or comma-separated base URLs. Also reuses LOCAL_LLM_BASE_URL / OLLAMA_BASE_URL / RUNPOD_*.
COMPUTE_BACKENDS=""
COMPUTE_ROUTER_POLICY=""
COMPUTE_SPECULATIVE=""
COMPUTE_WARM_ON_START=""
COMPUTE_JOB_CONCURRENCY=""
COMPUTE_LOCAL_CONCURRENCY=""
COMPUTE_RUNPOD_CONCURRENCY=""
