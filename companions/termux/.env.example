# Remote Command Hub this companion talks to (laptop / VPS / Tailscale).
# The phone does NOT host the full hub.
HUB_BASE_URL=http://127.0.0.1:3100

# Optional. Required only when the remote hub set HUB_API_TOKEN or SECURE_MODE=1.
# Never commit a real value. After first Setup save, values live in gitignored config.local.json.
HUB_API_TOKEN=

# Display name used for SignalFrame presence heartbeats / notes.
OPERATOR_NAME=termux-op

# Companion listen address (Termux default).
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8788

# Set to 1 only for a lab hub with a self-signed TLS cert.
COMPANION_INSECURE_TLS=
